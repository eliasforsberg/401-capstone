# ============================================================
# AI Inventory Manager — Root Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# See README.md for the full environment variable matrix.
# ============================================================

# ----- Supabase -----------------------------------------------
# URL and anon key are printed by `supabase start` (local) or
# found in the Supabase dashboard → Settings → API (staging/prod).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<local-anon-key-from-supabase-start>
# Service role key — used only by Edge Functions / CI scripts.
# Never expose this to the mobile client.
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key-from-supabase-start>
# Project ref — needed for `supabase db push --project-ref`
SUPABASE_PROJECT_REF=<your-project-ref>

# ----- Square (local / sandbox) --------------------------------
# Obtain from developer.squareup.com → Sandbox credentials
SQUARE_ACCESS_TOKEN=<sandbox-access-token>
SQUARE_WEBHOOK_SIGNATURE_KEY=<sandbox-webhook-signature-key>
SQUARE_APPLICATION_ID=<sandbox-application-id>
SQUARE_ENVIRONMENT=sandbox
