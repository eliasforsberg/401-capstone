# ============================================================
# AI Inventory Manager — Mobile App Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real secrets.
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to
# client-side code. All other variables here are for build
# tooling only.
#
# See README.md for the full environment variable matrix.
# ============================================================

# ----- Supabase (public — safe to include in mobile bundle) ---
# Local dev: values printed by `supabase start`
# Staging / production: Supabase dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key-from-supabase-start>

# ----- Feature flags ------------------------------------------
# Set to "true" to enable push notifications (Phase 2 only).
EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=false
